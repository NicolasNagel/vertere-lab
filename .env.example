# Copy to .env and adjust. Never commit .env.
ENV=dev
LOG_LEVEL=INFO
# JSON array. Keep the Vite origin in dev; add other explicit local ports when needed.
TRUSTED_BROWSER_ORIGINS=["http://localhost:5173"]
# Matches docker-compose.yml (local dev database).
DATABASE_URL=postgresql+psycopg://vertere:vertere_dev@localhost:5432/vertere_lab

# Opaque session cookie (docs/adr/001-autenticacao-sessao-opaca-argon2.md).
SESSION_COOKIE_NAME=vertere_session
# false only for local dev without HTTPS; always true in staging/production.
SESSION_COOKIE_SECURE=true
SESSION_TTL_MINUTES=30
SESSION_TTL_REMEMBER_ME_DAYS=30
SESSION_RENEWAL_THRESHOLD_MINUTES=10

# CEP lookup (address autofill) — no API key required.
VIACEP_BASE_URL=https://viacep.com.br
VIACEP_TIMEOUT_SECONDS=3.0

# First SUPER_ADMIN bootstrap (app/scripts/bootstrap_admin.py) — run
# manually once per environment, never from CI/deploy automation.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_FULL_NAME=
BOOTSTRAP_ADMIN_PASSWORD=
